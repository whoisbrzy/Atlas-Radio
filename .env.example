# Copy to .env for local development with `vercel dev`,
# or set these in Vercel: Project → Settings → Environment Variables.

# Discord application client ID (public — appears in the OAuth URL)
DISCORD_CLIENT_ID=

# Discord OAuth2 client secret (server-side only; never expose to browser code)
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs allowed to open the developer panel
# e.g. DEVELOPER_IDS=123456789012345678,987654321098765432
DEVELOPER_IDS=
