{
  "name": "atlas-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local text-to-speech audio routing for Discord desktop",
  "author": {
    "name": "whoisbrzy",
    "email": "applekingali@gmail.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package:windows": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "electron": "^44.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.whoisbrzy.atlas.desktop",
    "productName": "Atlas Desktop",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
